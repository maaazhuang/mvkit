include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

# 生产实现使用 C++20；公开头支持 C11/C++14；开发阶段不承诺 ABI 兼容。
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)

if(MSVC)
  add_compile_options(/utf-8)
endif()

# 所有构建产物集中在 build；Windows 多配置产物按配置分目录。
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
if(WIN32)
  set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
  set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
  foreach(_cfg IN ITEMS Debug Release RelWithDebInfo MinSizeRel)
    string(TOUPPER "${_cfg}" _cfg_upper)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_${_cfg_upper} ${CMAKE_BINARY_DIR}/bin/${_cfg})
    set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_${_cfg_upper} ${CMAKE_BINARY_DIR}/bin/${_cfg})
    set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_${_cfg_upper} ${CMAKE_BINARY_DIR}/lib/${_cfg})
  endforeach()
endif()

if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()
# 统一查找系统开发库，缺失时复用 3rdparty 源码或校验后下载。
include(cmake/Dependencies.cmake)

set(MVKIT_3RDPARTY_DIR ${CMAKE_CURRENT_SOURCE_DIR}/3rdparty)
option(MVKIT_USE_EIGEN "Use the vendored Eigen numerical backend" ON)
option(MVKIT_WARNINGS_AS_ERRORS "Treat compiler warnings as errors" OFF)
# 按编译器提供的能力启用检查器；互斥或不支持的组合直接报错。
option(MVKIT_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(MVKIT_ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(MVKIT_ENABLE_TSAN "Enable ThreadSanitizer" OFF)
if(MVKIT_ENABLE_ASAN AND MVKIT_ENABLE_TSAN)
  message(FATAL_ERROR "AddressSanitizer and ThreadSanitizer require separate builds")
endif()
if(MSVC)
  if(MVKIT_ENABLE_UBSAN OR MVKIT_ENABLE_TSAN)
    message(FATAL_ERROR "MSVC does not provide UBSan/TSan; use a Clang or GCC CI build")
  endif()
  if(MVKIT_ENABLE_ASAN)
    add_compile_options(/fsanitize=address)
    add_link_options(/INCREMENTAL:NO)
  endif()
elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  set(mvkit_sanitizers)
  if(MVKIT_ENABLE_ASAN)
    list(APPEND mvkit_sanitizers address)
  endif()
  if(MVKIT_ENABLE_UBSAN)
    list(APPEND mvkit_sanitizers undefined)
  endif()
  if(MVKIT_ENABLE_TSAN)
    list(APPEND mvkit_sanitizers thread)
  endif()
  if(mvkit_sanitizers)
    string(JOIN "," mvkit_sanitizer_list ${mvkit_sanitizers})
    add_compile_options(-fsanitize=${mvkit_sanitizer_list}
                        -fno-omit-frame-pointer)
    add_link_options(-fsanitize=${mvkit_sanitizer_list})
  endif()
elseif(MVKIT_ENABLE_ASAN OR MVKIT_ENABLE_UBSAN OR MVKIT_ENABLE_TSAN)
  message(FATAL_ERROR "requested sanitizer is unsupported by this compiler")
endif()

# 内存与并行后端选项决定运行时源码和生成配置，保持平台逻辑一致。
option(MVKIT_ENABLE_MEMORY_POOL "Enable pooled memory backend" ON)
set(MVKIT_MEMORY_BACKEND "builtin" CACHE STRING "system|builtin|custom")
set_property(CACHE MVKIT_MEMORY_BACKEND PROPERTY STRINGS system builtin custom)
option(MVKIT_ENABLE_PARALLEL "Enable internal parallel execution" OFF)
set(MVKIT_PARALLEL_BACKEND "serial" CACHE STRING "serial|builtin|openmp|tbb|custom")
set_property(CACHE MVKIT_PARALLEL_BACKEND PROPERTY STRINGS serial builtin openmp tbb custom)
function(mvkit_validate_runtime_backend_options)
  set(valid_memory system builtin)
  set(valid_parallel serial builtin)
  if(NOT MVKIT_MEMORY_BACKEND IN_LIST valid_memory)
    message(FATAL_ERROR
      "MVKIT_MEMORY_BACKEND='${MVKIT_MEMORY_BACKEND}' is not implemented")
  endif()
  if(NOT MVKIT_PARALLEL_BACKEND IN_LIST valid_parallel)
    message(FATAL_ERROR
      "MVKIT_PARALLEL_BACKEND='${MVKIT_PARALLEL_BACKEND}' is not implemented")
  endif()
  if(MVKIT_ENABLE_MEMORY_POOL AND NOT MVKIT_MEMORY_BACKEND STREQUAL "builtin")
    message(FATAL_ERROR "MVKIT_ENABLE_MEMORY_POOL=ON requires MVKIT_MEMORY_BACKEND=builtin")
  endif()
  if(NOT MVKIT_ENABLE_MEMORY_POOL AND NOT MVKIT_MEMORY_BACKEND STREQUAL "system")
    message(FATAL_ERROR "MVKIT_MEMORY_BACKEND=builtin requires MVKIT_ENABLE_MEMORY_POOL=ON")
  endif()
  if(MVKIT_ENABLE_PARALLEL AND NOT MVKIT_PARALLEL_BACKEND STREQUAL "builtin")
    message(FATAL_ERROR "MVKIT_ENABLE_PARALLEL=ON requires MVKIT_PARALLEL_BACKEND=builtin")
  endif()
  if(NOT MVKIT_ENABLE_PARALLEL AND NOT MVKIT_PARALLEL_BACKEND STREQUAL "serial")
    message(FATAL_ERROR "MVKIT_PARALLEL_BACKEND=builtin requires MVKIT_ENABLE_PARALLEL=ON")
  endif()
endfunction()
mvkit_validate_runtime_backend_options()
if(MVKIT_MEMORY_BACKEND STREQUAL "system")
  set(MVKIT_MEMORY_BACKEND_SYSTEM 1)
  set(MVKIT_MEMORY_BACKEND_BUILTIN 0)
else()
  set(MVKIT_MEMORY_BACKEND_SYSTEM 0)
  set(MVKIT_MEMORY_BACKEND_BUILTIN 1)
endif()
if(MVKIT_PARALLEL_BACKEND STREQUAL "serial")
  set(MVKIT_PARALLEL_BACKEND_SERIAL 1)
  set(MVKIT_PARALLEL_BACKEND_BUILTIN 0)
else()
  set(MVKIT_PARALLEL_BACKEND_SERIAL 0)
  set(MVKIT_PARALLEL_BACKEND_BUILTIN 1)
endif()
# 依据实际目标架构及编译宏选择 SIMD，不能按宿主机器推断。
include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/Architecture.cmake)
mvkit_detect_target_architecture()
message(STATUS
  "MVKit: target_arch=${MVKIT_TARGET_ARCH} "
  "source=${MVKIT_TARGET_ARCH_SOURCE} "
  "compile_probe=${MVKIT_COMPILE_ARCH_PROBE} "
  "avx2_kernel=${MVKIT_ENABLE_AVX2_KERNEL}")
configure_file(
  ${CMAKE_CURRENT_SOURCE_DIR}/src/runtime/config/generated_backend_config.hpp.in
  ${CMAKE_CURRENT_BINARY_DIR}/generated/mvkit/runtime/generated_backend_config.hpp
  @ONLY)
if(MVKIT_WARNINGS_AS_ERRORS)
  if(MSVC)
    add_compile_options(/W4 /WX /permissive-)
  else()
    add_compile_options(-Wall -Wextra -Wpedantic -Werror)
  endif()
endif()

find_package(Threads REQUIRED)
